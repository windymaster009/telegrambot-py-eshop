BOT_TOKEN=replace_with_your_new_botfather_token
# Plain comma-separated and JSON-style lists are both accepted.
ADMIN_IDS=[123456789]
SUPPORT_USERNAME=@your_support_username
SHOP_NAME=Windy Shop

# Backend-only secrets. Never expose either value in browser JavaScript.
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=eshop
API_KEY=replace_with_at_least_32_random_characters

# Customer-facing BLINK/KHQR poster bundled with the project.
PAYMENT_QR_PATH=assets/payment_qr.png
PAYMENT_ACCOUNT_NAME=YOUR NAME
PAYMENT_ACCOUNT_NUMBER=000 000 000
PAYMENT_EXPIRY_MINUTES=30
TOPUP_EXPIRY_MINUTES=15

# Automatic wallet top-ups from a private ABA notification group.
# Use a separate Telegram bot token for the listener.
AUTO_TOPUP_ENABLED=false
PAYMENT_CHECK_BOT_TOKEN=
ABA_PAYMENT_GROUP_ID=
ABA_PAYMENT_BOT_USERNAME=PayWayByABA_bot
