[Unit]
Description=Windy Telegram Shop API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kevin
WorkingDirectory=/home/kevin/telegrambot-py-eshop
EnvironmentFile=/home/kevin/telegrambot-py-eshop/.env
ExecStart=/home/kevin/telegrambot-py-eshop/.venv/bin/uvicorn app.api:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
